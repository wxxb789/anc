---
import '../styles/global.css';
// `?url` keeps this a classic, render-blocking script: Astro compiles a normal
// `<script>` to `type="module"`, which defers and would paint one frame of the
// wrong theme. Importing the URL keeps the source under `src/scripts/` and
// content-hashed, while the tag stays inline-free and same-origin.
import themeInit from '../scripts/theme-init.js?url';

interface Props {
  title: string;
  description?: string;
  /** BCP 47 tag from the document's own metadata, when the artifact carries one. */
  lang?: string;
}

/** The single navigation language, used whenever a document declares none. */
const NAV_LANGUAGE = 'en';

const {
  title,
  description = 'A static public projection from thoughtscape.',
  lang = NAV_LANGUAGE,
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline src={themeInit}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href="/">thoughtscape</a>
      <nav class="site-nav" aria-label="Primary">
        <a href="/#notes">Notes</a>
        <button id="search-toggle" type="button" data-js-only>Search</button>
        <button id="theme-toggle" type="button" data-js-only>Theme: system</button>
        <button id="reader-toggle" type="button" aria-pressed="false" data-js-only>Reader mode</button>
      </nav>
    </header>
    <dialog id="search-dialog" aria-label="Search">
      <form method="dialog"><button>Close search</button></form>
      <div id="search"></div>
    </dialog>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>A reviewed public projection from a private knowledge garden.</p>
      {/* Scope item 10 requires the printed page to carry its canonical URL.
          The absolute origin is configured by TK-08, so this prints the route
          and TK-08 upgrades it to the full URL. Print-only: the on-screen
          footer's provenance block is TK-05's. */}
      <p class="print-only">Published at {Astro.url.pathname}</p>
    </footer>
    <div id="link-preview" role="tooltip" hidden></div>
    <script>
      import '../scripts/preferences.ts';
      import '../scripts/search-dialog.ts';
      import '../scripts/link-preview.ts';
    </script>
    <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  </body>
</html>
