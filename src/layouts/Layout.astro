---
import '../styles/global.css';
// `?url` keeps this a classic, render-blocking script: Astro compiles a normal
// `<script>` to `type="module"`, which defers and would paint one frame of the
// wrong theme. Importing the URL keeps the source under `src/scripts/` and
// content-hashed, while the tag stays inline-free and same-origin.
import themeInit from '../scripts/theme-init.js?url';
import SiteMetadata from '../components/SiteMetadata.astro';
import CollectionExplorer from '../components/CollectionExplorer.astro';
import { entries } from '../lib/content.ts';
import { collectionNavigation } from '../lib/collection-navigation.ts';
import { PRIMARY_NAV, SITE_MAP } from '../lib/routes.ts';
import { canonicalUrl, describe, SITE_NAME } from '../lib/site.ts';
import { NAV_LANGUAGE, THEME_NAMES, translate } from '../lib/translations.ts';

interface Props {
  title: string;
  description?: string;
  /** BCP 47 tag from the document's own metadata, when the artifact carries one. */
  lang?: string;
}

const { title, lang = NAV_LANGUAGE } = Astro.props;

/**
 * This document's chrome, resolved from this document's own language.
 *
 * The whole of TK-16 is that this line reads `lang` — a per-entry field on the
 * validated contract — rather than one site-wide locale. A zh-CN note therefore
 * renders Chinese chrome inside `<html lang="zh-CN">` while an English note in
 * the same build renders English chrome, which is a shape Quartz's global
 * `cfg.locale` cannot express. Routes that are not a single document pass no
 * `lang` and land on `NAV_LANGUAGE`; `translations.ts` documents why.
 */
const t = translate(lang);

/**
 * `describe` rather than a default parameter, and that is a fix rather than a
 * refactor: a default only fires on `undefined`, while the note page passes
 * `entry.excerpt` — the one required string the content contract admits *empty*.
 * A note with an empty excerpt therefore shipped
 * `<meta name="description" content="">`, which is worse than no tag at all,
 * since a consumer scrapes the page when the tag is absent and renders nothing
 * when it is present and empty. The fixture corpus has exactly one such note.
 *
 * The fallback is this document's own, so a Chinese note with an empty excerpt
 * describes itself in Chinese rather than falling back across a language.
 */
const description = describe(Astro.props.description, t.siteDescription);

/**
 * The explorer rail's groups, resolved against the route being rendered.
 *
 * Computed in the layout rather than passed in by each page, so every route
 * carries the same navigation frame by construction — a page that forgets to
 * ask is the failure mode this prevents, and it is the same reason
 * `SiteMetadata` lives here. `Astro.url.pathname` is what makes the rail
 * contextual: it opens the group holding the current page and no other.
 */
const explorerGroups = collectionNavigation(entries, Astro.url.pathname, t.uncollected);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline src={themeInit}></script>
    {/* TK-08: the canonical URL, the Open Graph and Twitter card metadata, and
        the feed discovery link. Rendered here rather than by each page so that
        every route carries them by construction — a page that forgets to ask
        is the failure mode this prevents. It derives everything from
        `Astro.site`, `Astro.url`, and the artifact; it takes no new props
        beyond the three this layout already has. */}
    <SiteMetadata title={title} description={description} lang={lang} />
    {/* The one seam a page has into the document head.
        TK-15 fills it with the math stylesheet and font, gated on
        `RenderedNote.hasMath`, and the Mermaid assets gated on `.hasMermaid`.
        `src/pages/notes/[slug].astro` already uses it for the `hasCode` case,
        so the mechanism is exercised rather than speculative.

        A named slot rather than a widening `Props` interface: a per-ticket prop
        would make this file the contended one every time a ticket needs a tag
        in the head, which is the collision the wave plan exists to avoid. */}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skipToContent}</a>
    <header class="site-header">
      {/* The site's name is a proper noun, so it is the one word in this header
          that is not translated — see `SITE_NAME`. */}
      <a class="brand" href="/">{SITE_NAME}</a>
      <nav class="site-nav" aria-label={t.primaryNavLabel}>
        {PRIMARY_NAV.map((item) => <a href={item.href}>{t[item.label]}</a>)}
        {/* The shortcut is in the accessible name rather than in a `title`,
            which no screen reader reliably announces and no keyboard reader
            can discover. `aria-keyshortcuts` is the attribute that exists for
            exactly this, and the visible text stays one word. */}
        <button
          id="search-toggle"
          type="button"
          aria-keyshortcuts="/"
          aria-label={t.searchToggleLabel}
          data-js-only
        >{t.searchToggle}</button>
        {/* The three theme labels travel as `data-` attributes rather than as a
            locale table in the bundle: `preferences.ts` cycles the attribute and
            reads back the label the build already resolved, so the script ships
            no strings, knows no locale, and adds no bytes that scale with the
            number of languages. The rendered text is the `system` label, which
            is the state before any preference is stored. */}
        <button
          id="theme-toggle"
          type="button"
          data-js-only
          {...Object.fromEntries(
            THEME_NAMES.map((theme) => [`data-label-${theme}`, t.themeLabel(theme)]),
          )}
        >{t.themeLabel(THEME_NAMES[0])}</button>
        <button id="reader-toggle" type="button" aria-pressed="false" data-js-only>{t.readerToggle}</button>
      </nav>
    </header>
    {/* TK-06. Every region the search script fills is declared here in HTML
        rather than constructed in JavaScript, for three reasons: the `<label>`
        and the `<input>` stay a real labelled pair instead of Pagefind's
        `data-`-attribute substitute; the dialog has something to focus the
        instant it opens, before the bundle has loaded; and the status line is a
        live region that exists before the first message is written into it, so
        the message is announced rather than silently appearing.

        `data-pagefind-ignore` on the whole dialog: it is on every page, so
        without it the index would carry this chrome on all 32 notes — the same
        defect TK-12 fixed for the back link and the heading anchors.

        The close button is a `<form method="dialog">`, which needs no script
        and — per the parity plan §7.6 — never navigates, so `form-action 'none'`
        does not touch it. */}
    <dialog id="search-dialog" aria-label={t.searchDialogLabel} data-pagefind-ignore>
      <form method="dialog" class="search-close"><button>{t.searchClose}</button></form>
      <label class="search-label" for="search-input">{t.searchFieldLabel}</label>
      {/* `type="search"` for the browser's own clear control and the right
          on-screen keyboard. `autocomplete="off"` because a site search field
          offering the reader's previous queries from other sites is noise. */}
      <input id="search-input" type="search" autocomplete="off" autocapitalize="none" enterkeyhint="search" />
      <div id="search-filters">
        <div id="search-filter-tag"></div>
        <div id="search-filter-collection"></div>
      </div>
      {/* `role="status"` is an `aria-live="polite"` region: the reader hears
          "Loading the search index" or "No results" without focus moving off
          the field they are typing into.

          The four load-state sentences travel as `data-` attributes for the same
          reason the theme labels do: `search-dialog.ts` reads the one it needs
          off this element, so the bundle carries no locale table and the page
          announces its own language. There is no rendered text — the region is
          empty until a state is announced, which is what makes the first message
          an announcement rather than a change nobody hears. */}
      <p
        id="search-status"
        role="status"
        data-message-idle={t.searchIdle}
        data-message-loading={t.searchLoading}
        data-message-empty={t.searchEmpty}
        data-message-failed={t.searchFailed}
      ></p>
      <ol id="search-results"></ol>
    </dialog>
    {/* The reading frame: the article, and the collection rail beside it.
        Requirements section 16 asks for an explorer, a centred article, and a
        contextual rail on desktop; collapsible panels on tablet; one column on
        mobile. This grid is all three — see `.page-shell` in `global.css`.

        The rail follows `<main>` in document order at every width, and the
        stylesheet never reorders it. That is what keeps the reading order, the
        tab order, and the visual order the same thing: a reader tabbing forward
        reaches the article before the site-wide navigation, and a reader with no
        CSS gets the article first. Placing the explorer visually before the
        article — Quartz's left-hand shape — would mean either a DOM order that
        puts a list of every title on the site ahead of the page's own content,
        or a `grid-column` that makes the tab order disagree with the layout. */}
    <div class="page-shell">
      <main id="main" tabindex="-1">
        <slot />
        {/* The link preview panel (TK-07). Empty until a preview opens, and
            `position: fixed`, so it contributes no layout wherever it sits — but
            it must sit inside a landmark. axe-core's `region` rule reports every
            element of page content that is in none, and an open panel parented to
            `<body>` was exactly that: it was reported on every route, in both
            themes, at both widths, and moving it here is what cleared it.

            That audit is run out of band and is not reproducible from this
            repository — axe-core is in neither `dependencies` nor
            `devDependencies`, so the check needs an `axe.min.js` fetched to a
            scratch path. TK-09 owns the question of whether it becomes a release
            gate. Recorded this way deliberately: the rule the panel was breaking
            is nameable and checkable by anyone who runs axe, which is worth more
            than a violation count nothing here can recompute.

            After the slot, so the document order a screen reader walks puts a
            transient description of a link after the content that contains the
            link, rather than before the article it describes. */}
        <div id="link-preview" role="tooltip" hidden></div>
      </main>
      {/* TK-05c. Built entirely at build time and collapsed with native
          `<details>`, so it is complete and operable with scripting disabled —
          the Quartz explorer failure the parity plan's L5 names. It renders
          nothing at all on a corpus with fewer than two notes. */}
      <CollectionExplorer groups={explorerGroups} lang={lang} />
    </div>
    <footer class="site-footer">
      {/* Every fixed route is linked from here, on every page, so no route is an
          orphan. This nav deliberately survives reader mode, which hides the
          header's secondary links: hiding the only path to a route would make
          reader mode remove information rather than chrome. */}
      <nav class="site-map" aria-label={t.siteMapLabel}>
        {SITE_MAP.map((item) => <a href={item.href}>{t[item.label]}</a>)}
      </nav>
      <p>{t.siteSubtitle}</p>
      {/* Scope item 10 requires the printed page to carry its canonical URL.
          A printed page has no address bar, so the full absolute URL is what
          makes it findable again — TK-05a emitted the route and left this for
          TK-08 to upgrade once `site:` was configured. */}
      <p class="print-only">{t.publishedAt(canonicalUrl(Astro.site, Astro.url.pathname))}</p>
    </footer>
    <script>
      import '../scripts/preferences.ts';
      import '../scripts/search-dialog.ts';
      import '../scripts/link-preview.ts';
    </script>
  </body>
</html>
