---
/**
 * The graph, as real HTML.
 *
 * This is the component the whole ticket is about, and its shape is the
 * argument: **inline SVG containing real `<a>` elements, laid out at build
 * time**. It is crawlable, keyboard-navigable, and complete with scripting
 * disabled — none of which Quartz's graph is, because `Graph.tsx` emits three
 * empty `<div>`s and everything else arrives as roughly 525 KB brotli of d3 and
 * PixiJS from a third-party CDN.
 *
 * Six properties are load-bearing:
 *
 * 1. **No JavaScript, and none to load.** `src/lib/graph.ts` computed every
 *    coordinate during the build. TK-21's interactive layer enhances this and
 *    must not be stubbed in here — what ships must be what survives when that
 *    enhancement fails.
 * 2. **No inline `style`, anywhere.** An SVG is exactly where they creep in, and
 *    the CSP is `style-src 'self'`. Every visual property is a class in
 *    `src/styles/graph.css` or an SVG presentation attribute; geometry travels
 *    in `cx`, `cy`, `x1`, and the rest, which are attributes rather than styles.
 * 3. **Direction is never carried by colour.** Requirements section 17 forbids
 *    it and section 13.2 requires the distinction. An outgoing edge is solid, an
 *    incoming one dashed, a mutual one solid with an arrowhead at both ends —
 *    three different *shapes*, legible in monochrome — and each node's
 *    accessible name says the relationship in words.
 * 4. **Every node is a link with a real accessible name.** The circle and the
 *    label are `aria-hidden`, because a screen reader reading a truncated label
 *    beside a full one is reading the same note twice; the `<a>` carries the
 *    untruncated title, the relationship, and the drawn degree through
 *    `graphNodeLabel`. Decorative parts hidden, content parts named.
 * 5. **The table is the equivalent representation**, not a fallback. It carries
 *    the same notes, the same relationships, and the same drawn degrees, in the
 *    same order, and it is present whether or not the SVG rendered.
 * 6. **Chrome is per document.** Every string comes from `translate()`, so a
 *    zh-CN note's graph is in Chinese — including the accessible names, which
 *    are the strings a reader never sees and a screen reader always does.
 *
 * `prefers-reduced-motion` needs no rule here: a static layout has nothing to
 * animate, which is the requirement satisfied by construction rather than by a
 * media query.
 */
import {
  NODE_RADIUS,
  SUBJECT_RADIUS,
  boundCounts,
  drawnNeighbours,
  hasDrawableGraph,
  type Graph,
  type GraphNode,
} from '../lib/graph.ts';
import { relationKey, type RelationKey } from '../lib/graph-layout.ts';
import { noteRoute } from '../lib/routes.ts';
import { partLanguage, translate } from '../lib/translations.ts';

interface Props {
  graph: Graph;
  /** Identifies the region: the heading takes `<region>-title`. */
  region: string;
  heading: string;
  /** How the layout was derived, since a reader cannot see a layout rule. */
  derivation: string;
  /** Rendered in place of the figure when there is nothing to draw. */
  empty: string;
  /** Where "show me the rest" goes, and what it says. */
  expand: { href: string; text: string; label: string };
  /**
   * Stated when the bound dropped notes. Takes the drawn and total *neighbour*
   * counts, which `boundCounts` computes — the subject is in neither.
   */
  bounded: (shown: number, total: number) => string;
  /** The page's own language, which decides every string's grammar. */
  lang: string;
  /** Heading level, so the region sits correctly in each page's outline. */
  level?: 1 | 2;
  /**
   * When present, a live explorer enhances this figure over the shared snapshot
   * Worker. Absent means the static figure is the whole experience.
   */
  explore?: {
    scope: 'local' | 'global';
    centerSlug: string | null;
    /** An initial tag filter for a global scope, if any. */
    initialTag?: string | null;
    /** Tag choices for a global scope; absent for a local one. */
    tags?: readonly { key: string; label: string }[];
  };
}

const {
  graph,
  region,
  heading,
  derivation,
  empty,
  expand,
  bounded,
  lang,
  level = 2,
  explore,
} = Astro.props;
const t = translate(lang);

const titleId = `${region}-title`;
const Heading = `h${level}` as 'h1' | 'h2';

/**
 * The relationship word each state carries, in this document's language.
 *
 * Keyed by the shared `relationKey` classifier, so a sixth state or a rename
 * fails this record instead of falling through to a wrong word — and the
 * `data-graph-relation-<key>` attributes the client reads are derived from the
 * same keys below rather than re-spelled.
 */
const relationLabels: Record<RelationKey, string> = {
  subject: t.graphSubjectRelation,
  outgoing: t.graphOutgoingRelation,
  incoming: t.graphIncomingRelation,
  mutual: t.graphMutualRelation,
  linked: t.graphLinkedRelation,
};

/** The relationship word a node's accessible name and the table both use. */
function relationOf(node: Graph['nodes'][number]): string {
  return relationLabels[relationKey(node)];
}

/** The class carrying a node's role. Shape and weight, never colour alone. */
function nodeClass(node: GraphNode): string {
  return node.isSubject ? 'graph-node graph-node-subject' : 'graph-node';
}

const isDrawable = hasDrawableGraph(graph);
const drawn = graph.nodes.length;

/**
 * The two numbers the bound sentence interpolates, from the model.
 *
 * Computed by `boundCounts` rather than here: the sentence counts *neighbouring
 * notes* and a note is not its own neighbour, which two shipped versions got
 * wrong — and a test restating the same arithmetic did not catch the second,
 * because it compared the model against a copy of this expression rather than
 * against this component. Neither corpus reaches the bound, so no built page
 * renders the sentence and no gate over `dist/` can see it either.
 */
const { shown, total } = boundCounts(graph);

/** Which notes each drawn node is joined to, for the table's fourth column. */
const joined = drawnNeighbours(graph);

/**
 * The client's chrome, carried as data attributes so the script bundle holds no
 * locale table. Only the attributes the explorer reads are emitted.
 */
const exploreData = explore
  ? Object.fromEntries([
      ['data-graph-scope', explore.scope],
      ['data-graph-center', explore.centerSlug ?? ''],
      ['data-graph-initial-tag', explore.initialTag ?? ''],
      ['data-graph-recenter', t.graphExplorerRecenter],
      // The same visible text, but named for the note it re-centers on: a table
      // holds one of these per row, so twelve identical "Re-center" names say
      // nothing about which control does what.
      ['data-graph-recenter-label', t.graphExplorerRecenterLabel('{title}')],
      ['data-graph-status-local', t.graphExplorerStatusLocal],
      ['data-graph-status-global', t.graphExplorerStatusGlobal],
      ['data-graph-status-filtered', t.graphExplorerStatusFiltered],
      ['data-graph-failed', t.graphExplorerFailed],
      ['data-graph-unknown-center', t.graphExplorerUnknownCenter],
      ['data-graph-empty-filter', t.graphExplorerEmptyFilter],
      ['data-graph-node-label', t.graphExplorerNodeLabel],
      ['data-graph-node-label-one', t.graphExplorerNodeLabelOne],
      // The live figure's accessible name, count-free on purpose: the count
      // sentence is the status line's job.
      ['data-graph-figure-name', t.graphDescription],
      ...Object.entries(relationLabels).map(([key, label]) => [
        `data-graph-relation-${key}`,
        label,
      ]),
      ['data-graph-no-links', t.graphNoLinks],
    ])
  : undefined;
---

<section class="graph-region" aria-labelledby={titleId} data-graph-region={region}>
  <div class="section-heading">
    <Heading id={titleId}>{heading}</Heading>
    {isDrawable && (
      <span data-graph-figure-label>{t.graphFigureLabel(drawn, graph.edges.length)}</span>
    )}
  </div>

  {/* Progressive enhancement, offered only where a figure exists to enhance:
      on an edge-less corpus an explorer would draw nothing while its live
      status claimed a graph. Hidden until the client runs; every string is a
      `data-` attribute above, so the script carries no locale table. */}
  {explore && isDrawable && (
    <div class="graph-explorer" hidden data-graph-controls {...exploreData}>
      <button type="button" data-graph-activate>{t.graphExplorerOpen}</button>
      <button type="button" data-graph-reset-control hidden>{t.graphExplorerReset}</button>
      {explore.tags && explore.tags.length > 0 && (
        <label>
          <span>{t.graphExplorerFilterLabel}</span>
          <select data-graph-tag>
            <option value="">{t.graphExplorerFilterAll}</option>
            {explore.tags.map((tag) => (
              <option value={tag.key}>{tag.label}</option>
            ))}
          </select>
        </label>
      )}
    </div>
  )}
  {/* The live status line belongs with the controls and the figure they
      enhance; with nothing drawable the empty state below is the whole
      statement, so there is no second sentence for the client to fill. */}
  {isDrawable && <p class="graph-status" role="status" aria-live="polite" data-graph-status></p>}

  {!isDrawable ? (
    <p class="empty-state">{empty}</p>
  ) : (
    <>
      {/* The scroll container is a keyboard stop, for the reason a `<pre>` and a
          diagram canvas are: a graph wider than the measure scrolls
          horizontally at 320 px, and a scrollable region must be reachable by
          keyboard (axe `scrollable-region-focusable`, WCAG 2.1.1).

          The `<figure>` takes no `aria-labelledby`: a figure with a figcaption
          is already named by it, and naming it twice is how an element ends up
          announced twice. */}
      <figure class="graph">
        <div class="graph-canvas" tabindex="0" data-graph-canvas>
          {/*
            `role="group"`, **not** `role="img"`.

            An `img` is a leaf: the accessibility API presents it as a single
            graphic, so a focusable descendant inside one is a contradiction —
            axe reports it as `nested-interactive` (serious), 56 times across
            the fixture corpus in both themes, which is how this was found. And
            it is not a lint technicality: under `role="img"` the node links are
            in the tab order while being inside a subtree a screen reader
            announces as one image, so a reader can focus links their own screen
            reader has flattened away.

            `group` is what this actually is — a named set of related elements
            that may contain interactive descendants. The name still states the
            counts, because the figure's size is the first thing a sighted
            reader takes in and the one thing a non-visual reader cannot.

            `focusable="false"` keeps the `<svg>` element itself out of the tab
            order, so the group is a container rather than one more stop before
            its first node.

            `width` and `height` are attributes rather than CSS so the figure has
            an intrinsic size and an aspect ratio before the stylesheet arrives —
            no layout shift, and the `viewBox` scales it down to fit.
          */}
          <svg
            class="graph-svg"
            viewBox={graph.viewBox}
            width={graph.width}
            height={graph.height}
            role="group"
            focusable="false"
            aria-label={t.graphFigureLabel(drawn, graph.edges.length)}
          >
            {/* The arrowhead, declared once and referenced by every edge. It is
                pure decoration — direction is stated in words on each node's
                accessible name — so the whole `<defs>` is hidden. */}
            <defs aria-hidden="true">
              <marker
                id={`${region}-arrow`}
                class="graph-arrow"
                viewBox="0 0 10 10"
                refX="9"
                refY="5"
                markerWidth="5"
                markerHeight="5"
                orient="auto-start-reverse"
              >
                <path d="M 0 1 L 9 5 L 0 9 z" />
              </marker>
            </defs>

            {/* Edges first, so a node's circle paints over the line that reaches
                it. `aria-hidden` on the whole group: an edge is not separately
                reachable, and the relationship it draws is already in the name
                of the node at its end and in the table below. */}
            <g class="graph-edges" aria-hidden="true">
              {graph.edges.map((edge) => (
                <line
                  class={[
                    'graph-edge',
                    edge.isMutual && 'graph-edge-mutual',
                    // An edge the subject *receives* is dashed and one it sends
                    // is solid, so the distinction is a shape rather than a
                    // colour. `/graph/` has no subject, so its edges carry no
                    // direction and are drawn plain — there is no "incoming"
                    // without a somewhere to come in to.
                    edge.direction === 'incoming' && 'graph-edge-incoming',
                  ]
                    .filter(Boolean)
                    .join(' ')}
                  x1={edge.x1}
                  y1={edge.y1}
                  x2={edge.x2}
                  y2={edge.y2}
                  marker-end={`url(#${region}-arrow)`}
                  marker-start={edge.isMutual ? `url(#${region}-arrow)` : undefined}
                />
              ))}
            </g>

            <g class="graph-nodes">
              {graph.nodes.map((node) => (
              /*
               * A real `<a href>`, which is the whole point: this is a link in
               * the HTML, so a crawler follows it, the keyboard reaches it, and
               * it works with scripting disabled.
               *
               * `aria-label` on the anchor and `aria-hidden` on everything
               * inside it: the circle is decoration and the visible label is a
               * truncation of the title the anchor already states. Without the
               * hiding, a screen reader announces the shortened title and then
               * the full one.
               */
              <a
                class={nodeClass(node)}
                href={noteRoute(node.entry.slug)}
                aria-label={t.graphNodeLabel(node.entry.title, relationOf(node), node.degree)}
                lang={partLanguage(node.entry.language, lang)}
              >
                <circle
                  class="graph-dot"
                  cx={node.x}
                  cy={node.y}
                  r={node.isSubject ? SUBJECT_RADIUS : NODE_RADIUS}
                  aria-hidden="true"
                />
                {/* `dy` places the label below the circle by an em rather than
                    by a pixel count, so it follows the reader's own text size. */}
                <text class="graph-label" x={node.x} y={node.y} dy="1.9em" aria-hidden="true">{node.label}</text>
              </a>
            ))}
            </g>
          </svg>
        </div>
        <figcaption>{derivation}</figcaption>
      </figure>

      {/*
        Requirements section 17: "graph data available as an equivalent
        list/table". **Equivalent**, so the fourth column exists: it names the
        notes each row is joined to, which is the edge set itself. A table of
        node, relationship, and a *degree* states how many lines touch a node
        while withholding which notes they run to — and on `/graph/`, where no
        node has a relationship to a subject, that would leave the whole edge
        set unavailable to a non-visual reader. A count is the summary section
        17 excludes.

        It is a `<details>` rather than an always-open table: the same data in
        two forms one after the other is a long page, and native disclosure
        costs no script, is keyboard-operable, and is announced as one. The
        summary states what is inside, so nobody has to open it to find out.
      */}
      <details class="graph-table">
        <summary>{t.graphTableCaption}</summary>
        {/* The scroll container the article's own Markdown tables still lack:
            four columns do not fit 320 px, and a wrapper is what lets the table
            scroll instead of widening the page while keeping its semantics —
            `display: block` on the `<table>` itself would strip them. It is a
            keyboard stop for the same reason the figure's canvas is (axe
            `scrollable-region-focusable`, WCAG 2.1.1). */}
        <div class="graph-table-scroll" tabindex="0">
          <table>
          <caption class="sr-only">{t.graphTableCaption}</caption>
          <thead>
            <tr>
              <th scope="col">{t.graphColumnNote}</th>
              <th scope="col">{t.graphColumnRelation}</th>
              <th scope="col">{t.graphColumnLinks}</th>
              <th scope="col">{t.graphColumnLinkedTo}</th>
            </tr>
          </thead>
          <tbody data-graph-body>
            {graph.nodes.map((node) => (
              <tr>
                <th scope="row">
                  <a href={noteRoute(node.entry.slug)} lang={partLanguage(node.entry.language, lang)}
                  >{node.entry.title}</a>
                </th>
                <td>{relationOf(node)}</td>
                <td>{node.degree}</td>
                <td>
                  {/* The notes at the other end of every line this node
                      carries, each a link — so the table is a way *through* the
                      graph and not only a description of it. A node the figure
                      draws with no line to another drawn node says so rather
                      than rendering an empty cell, which reads as missing data. */}
                  {(joined.get(node.entry.slug) ?? []).length === 0 ? (
                    <span class="graph-none">{t.graphNoLinks}</span>
                  ) : (
                    <ul class="graph-joined">
                      {(joined.get(node.entry.slug) ?? []).map((other) => (
                        <li>
                          <a
                            href={noteRoute(other.slug)}
                            lang={partLanguage(other.language, lang)}
                          >{other.title}</a>
                        </li>
                      ))}
                    </ul>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
          </table>
        </div>
      </details>

      {/* The bound, and the expansion action beside it — requirements section
          13.2. Rendered only when the bound actually dropped something, so a
          graph drawing everything does not claim to be partial. The link is
          unconditional: "see the whole graph" is useful whether or not this one
          was truncated. */}
      <p class="graph-bound">
        {graph.omitted > 0 && <span>{bounded(shown, total)} </span>}
        <a href={expand.href} aria-label={expand.label}>{expand.text}</a>
      </p>
    </>
  )}
</section>
