---
/**
 * A list of published notes, used by every route that shows more than one.
 *
 * The heading level is a prop because these lists appear at two depths: under a
 * section heading on the home page, and directly under the page `h1` on a
 * facet or recent page. Hardcoding one level would make the other route either
 * skip a heading level or carry a heading that restates its own title.
 */
import type { ContentEntry } from '../lib/content.ts';
import { noteRoute } from '../lib/routes.ts';
import { partLanguage, translate } from '../lib/translations.ts';

interface Props {
  entries: readonly ContentEntry[];
  /** Heading level for each card title, chosen so the page never skips a level. */
  level?: 2 | 3;
  /** The page's own language, which decides the chrome around these cards. */
  lang: string;
}

const { entries, level = 3, lang } = Astro.props;
const t = translate(lang);
const Heading = `h${level}` as 'h2' | 'h3';
---

{/* Only the home page and `/recent/` can reach the empty state: a facet page
    exists because an entry produced it, so its list is never empty. The message
    is the locale's rather than a caller's prop — every caller passed the same
    string, and a per-caller override nobody used is a string nobody maintains. */}
{entries.length === 0 ? (
  <p class="empty-state">{t.noNotesYet}</p>
) : (
  <div class="note-grid">
    {entries.map((entry) => (
      <article class="note-card">
        {/*
          The title and the excerpt are the author's words, so they are rendered
          verbatim — and marked with their own `lang` when it differs from the
          page's. Every route lists the whole corpus, so on a bilingual site most
          of these grids are mixed; without the attribute a screen reader reads a
          Chinese title in an English voice, which is WCAG 2.2 AA 3.1.2. The
          attribute is emitted only on the cards that need it, so a single-
          language corpus carries none.
        */}
        <Heading lang={partLanguage(entry.language, lang)}>
          <a href={noteRoute(entry.slug)}>{entry.title}</a>
        </Heading>
        <p lang={partLanguage(entry.language, lang)}>{entry.excerpt}</p>
        <a class="read-more" href={noteRoute(entry.slug)}>{t.readNote}</a>
      </article>
    ))}
  </div>
)}
