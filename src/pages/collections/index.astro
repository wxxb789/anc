---
/**
 * `/collections/` — the curated public collections.
 *
 * A corpus route, so the chrome is the navigation language. The collection
 * labels are artifact text and are never translated.
 */
import Layout from '../../layouts/Layout.astro';
import FacetIndex from '../../components/FacetIndex.astro';
import { entries } from '../../lib/content.ts';
import { collectionFacets, collectionRoute } from '../../lib/routes.ts';
import { TITLE_SUFFIX } from '../../lib/site.ts';
import { NAV_LANGUAGE, translate } from '../../lib/translations.ts';

const t = translate(NAV_LANGUAGE);
const facets = collectionFacets(entries);
---

<Layout title={`${t.collectionsTitle}${TITLE_SUFFIX}`} description={t.collectionsDescription}>
  <section aria-labelledby="collections-title">
    <div class="section-heading">
      <h1 id="collections-title">{t.collectionsTitle}</h1>
      <span>{t.collectionCount(facets.length)}</span>
    </div>
    <p class="facet-note">{t.collectionsNote}</p>
    <FacetIndex
      facets={facets}
      route={collectionRoute}
      empty={t.collectionsEmpty}
      lang={NAV_LANGUAGE}
    />
  </section>
</Layout>
