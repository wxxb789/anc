---
import Layout from '../../layouts/Layout.astro';
import NoteList from '../../components/NoteList.astro';
import { entries } from '../../lib/content.ts';
import { collectionFacets } from '../../lib/routes.ts';

export function getStaticPaths() {
  return collectionFacets(entries).map((facet) => ({ params: { slug: facet.key }, props: { facet } }));
}

const { facet } = Astro.props;
---

<Layout
  title={`Collection: ${facet.label} · thoughtscape`}
  description={`Published notes in the ${facet.label} collection.`}
>
  <section aria-labelledby="collection-title">
    <div class="section-heading">
      <h1 id="collection-title">Collection: {facet.label}</h1>
      <span>{facet.entries.length} {facet.entries.length === 1 ? 'note' : 'notes'}</span>
    </div>
    <p class="facet-note"><a href="/collections/">← All collections</a></p>
    <NoteList entries={facet.entries} level={2} />
  </section>
</Layout>
