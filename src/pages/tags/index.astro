---
/**
 * `/tags/` — every public tag in the projection.
 *
 * A corpus route, so the chrome is the navigation language. The tag labels
 * themselves are artifact text and are never translated: `security` stays
 * `security`, `笔记` stays `笔记`.
 *
 * `FacetIndex`'s anchors remain the complete no-JS route to each tag's page. The
 * chooser below is an additive enhancement that enumerates a selected tag in
 * place through the snapshot; switching tags resets the continuation.
 */
import Layout from '../../layouts/Layout.astro';
import FacetIndex from '../../components/FacetIndex.astro';
import { entries } from '../../lib/content.ts';
import { tagFacets, tagRoute } from '../../lib/routes.ts';
import { TITLE_SUFFIX } from '../../lib/site.ts';
import { TAG_PAGE_SIZE } from '../../lib/tag-browser-model.ts';
import { NAV_LANGUAGE, TAG_BROWSE_DATASET, datasetAttribute, translate } from '../../lib/translations.ts';

const t = translate(NAV_LANGUAGE);
const facets = tagFacets(entries);
const browserData = Object.fromEntries([
  [datasetAttribute(TAG_BROWSE_DATASET.loading), t.tagBrowseLoading],
  [datasetAttribute(TAG_BROWSE_DATASET.empty), t.tagBrowseEmpty],
  [datasetAttribute(TAG_BROWSE_DATASET.exhausted), t.tagBrowseExhausted],
  [datasetAttribute(TAG_BROWSE_DATASET.unknown), t.tagBrowseUnknown],
  [datasetAttribute(TAG_BROWSE_DATASET.failed), t.tagBrowseFailed],
]);
---

<Layout title={`${t.tagsTitle}${TITLE_SUFFIX}`} description={t.tagsDescription}>
  <section aria-labelledby="tags-title">
    <div class="section-heading">
      <h1 id="tags-title">{t.tagsTitle}</h1>
      <span>{t.tagCount(facets.length)}</span>
    </div>
    <FacetIndex facets={facets} route={tagRoute} empty={t.tagsEmpty} lang={NAV_LANGUAGE} />

    {facets.length > 0 && (
      <section
        id="tag-browser"
        hidden
        data-pagefind-ignore
        data-mode="switch"
        data-page-size={String(TAG_PAGE_SIZE)}
        aria-labelledby="tag-browser-title"
        {...browserData}
      >
        <h2 id="tag-browser-title">{t.tagBrowseHeading}</h2>
        <label for="tag-browser-select">{t.tagBrowseSelectLabel}</label>
        <select id="tag-browser-select">
          <option value="">{t.tagBrowsePrompt}</option>
          {facets.map((facet) => (
            <option value={facet.key}>{facet.label}</option>
          ))}
        </select>
        <p id="tag-browser-current" hidden></p>
        <p id="tag-browser-status" role="status"></p>
        <ol id="tag-browser-results"></ol>
        <button id="tag-browse-more" type="button" hidden>{t.tagBrowseMore}</button>
      </section>
    )}
  </section>
</Layout>
