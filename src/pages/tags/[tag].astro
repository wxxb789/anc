---
/**
 * `/tags/<key>/` — the notes carrying one tag.
 *
 * A facet aggregates many documents, so its chrome is the navigation language
 * rather than any member's. Resolving it from, say, the first note would make
 * this page's language depend on which entry sorts first — a public page
 * changing language because an unrelated note was published.
 *
 * The tag itself is interpolated into the heading and the title as artifact
 * text, unchanged.
 *
 * The complete static `NoteList` is always rendered. The enhanced region below it
 * is hidden until `tag-browser.ts` runs, so a reader with no scripting (or whose
 * chunk failed) sees the whole tag through the static route.
 */
import Layout from '../../layouts/Layout.astro';
import NoteList from '../../components/NoteList.astro';
import { entries } from '../../lib/content.ts';
import { tagFacets } from '../../lib/routes.ts';
import { TITLE_SUFFIX } from '../../lib/site.ts';
import { TAG_PAGE_SIZE } from '../../lib/tag-browser-model.ts';
import { NAV_LANGUAGE, TAG_BROWSE_DATASET, datasetAttribute, translate } from '../../lib/translations.ts';

export function getStaticPaths() {
  // No facets means no paths, which is the correct static answer: `/tags/` still
  // renders its empty state, and any `/tags/<anything>/` request is a 404
  // because that tag genuinely does not exist.
  return tagFacets(entries).map((facet) => ({ params: { tag: facet.key }, props: { facet } }));
}

const { facet } = Astro.props;
const t = translate(NAV_LANGUAGE);
const browserData = Object.fromEntries([
  [datasetAttribute(TAG_BROWSE_DATASET.loading), t.tagBrowseLoading],
  [datasetAttribute(TAG_BROWSE_DATASET.empty), t.tagBrowseEmpty],
  [datasetAttribute(TAG_BROWSE_DATASET.exhausted), t.tagBrowseExhausted],
  [datasetAttribute(TAG_BROWSE_DATASET.unknown), t.tagBrowseUnknown],
  [datasetAttribute(TAG_BROWSE_DATASET.failed), t.tagBrowseFailed],
]);
---

<Layout
  title={`${t.tagPageTitle(facet.label)}${TITLE_SUFFIX}`}
  description={t.tagPageDescription(facet.label)}
>
  <section aria-labelledby="tag-title">
    <div class="section-heading">
      <h1 id="tag-title">{t.tagPageTitle(facet.label)}</h1>
      <span>{t.noteCount(facet.entries.length)}</span>
    </div>
    <p class="facet-note"><a href="/tags/">{t.allTags}</a></p>

    <div id="tag-static-list">
      <NoteList entries={facet.entries} level={2} lang={NAV_LANGUAGE} />
    </div>

    {/* Hidden until the script runs, and the script unhides the static list on
        any failure. `data-pagefind-ignore` keeps this chrome out of the index. */}
    <section
      id="tag-browser"
      hidden
      data-pagefind-ignore
      data-mode="fixed"
      data-tag-key={facet.key}
      data-page-size={String(TAG_PAGE_SIZE)}
      aria-labelledby="tag-browser-title"
      {...browserData}
    >
      <h2 id="tag-browser-title">{t.tagBrowseHeading}</h2>
      <button id="tag-browse-start" type="button">{t.tagBrowseStart}</button>
      <p id="tag-browser-current" hidden></p>
      <p id="tag-browser-status" role="status"></p>
      <ol id="tag-browser-results"></ol>
      <button id="tag-browse-more" type="button" hidden>{t.tagBrowseMore}</button>
    </section>
  </section>
</Layout>
