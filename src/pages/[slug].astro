---
import Layout from '../layouts/Layout.astro';
import { entries, getEntry } from '../lib/content.ts';
import { renderMarkdown } from '../lib/markdown.ts';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
// The slug-to-route mapping is injected rather than assumed, so TK-04 can move
// notes to /notes/<slug>/ by changing this line alone. Returning undefined for
// an unpublished slug leaves that href untouched.
const { html } = await renderMarkdown(entry.markdown, {
  routeForSlug: (slug) => (getEntry(slug) ? `/${slug}/` : undefined),
});
---

<Layout title={`${entry.title} · thoughtscape`} description={entry.excerpt}>
  <article class="prose" data-pagefind-body>
    <a class="back-home" href="/">← All notes</a>
    <div set:html={html} />
  </article>

  {entry.backlinks.length > 0 && (
    <aside class="backlinks" aria-labelledby="backlinks-title">
      <h2 id="backlinks-title">Linked from</h2>
      <ul>
        {entry.backlinks.map((slug) => {
          const backlink = getEntry(slug);
          return backlink && <li><a href={`/${slug}/`}>{backlink.title}</a></li>;
        })}
      </ul>
    </aside>
  )}
</Layout>
