---
/**
 * `/recent/` — every published note, most recently updated first.
 *
 * A corpus route rather than a document route, so its chrome is the navigation
 * language. The note titles it lists are their authors' own words and carry
 * their own `lang` where it differs; `NoteList` handles that.
 */
import Layout from '../layouts/Layout.astro';
import NoteList from '../components/NoteList.astro';
import { entries } from '../lib/content.ts';
import { noteTimestamp, recentFirst } from '../lib/routes.ts';
import { TITLE_SUFFIX } from '../lib/site.ts';
import { NAV_LANGUAGE, translate } from '../lib/translations.ts';

const t = translate(NAV_LANGUAGE);
const ordered = recentFirst(entries);
// The artifact's date fields are optional. Saying which ordering a reader is
// actually looking at is the honest alternative to implying a recency the
// current artifact cannot support.
const dated = entries.some((entry) => noteTimestamp(entry) !== undefined);
---

<Layout title={`${t.recentTitle}${TITLE_SUFFIX}`} description={t.recentDescription}>
  <section aria-labelledby="recent-title">
    <div class="section-heading">
      <h1 id="recent-title">{t.recentTitle}</h1>
      <span>{t.publishedCount(ordered.length)}</span>
    </div>
    <p class="facet-note">{dated ? t.recentOrderedByDate : t.recentOrderedBySlug}</p>
    <NoteList entries={ordered} level={2} lang={NAV_LANGUAGE} />
  </section>
</Layout>
