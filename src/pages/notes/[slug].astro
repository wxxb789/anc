---
/**
 * The note page: requirements section 9.2's thirteen-element anatomy.
 *
 * Elements 1, 2, and part of 13 come from `Layout.astro` — the skip link, the
 * header with its search trigger, and the printed canonical route. Everything
 * else is here, in the order the requirements list them, and every region is
 * either rendered below or left as a named, empty slot with the ticket that
 * owns it. **Do not fill a slot from another ticket**: the slot is the contract.
 *
 * | § 9.2 element | Where |
 * | --- | --- |
 * | 1 skip link | `Layout.astro` |
 * | 2 header and search trigger | `Layout.astro` |
 * | 3 breadcrumbs | here |
 * | 4 title and public metadata | here |
 * | 5 optional summary | here |
 * | 6 table of contents | here, via `TableOfContents.astro` |
 * | 7 sanitized article content | here |
 * | 8 outgoing public links | here |
 * | 9 static backlinks | here |
 * | 10 related-note fallback | here, derived by `relations.ts` |
 * | 11 local-graph island | slot — TK-17 |
 * | 12 previous/next or collection navigation | here |
 * | 13 footer with provenance and canonical URL | here; the absolute URL is TK-08 |
 *
 * Nothing on this page needs JavaScript. The table of contents is server
 * rendered, the breadcrumbs are static, and the collapse is a `<details>`.
 */
import Layout from '../../layouts/Layout.astro';
import LinkedNotes from '../../components/LinkedNotes.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { entries, getEntry } from '../../lib/content.ts';
import { renderMarkdown } from '../../lib/markdown.ts';
import {
  RELATED_DERIVATION,
  collectionNeighbours,
  hasTagPeer,
  notesForSlugs,
  relatedNotes,
} from '../../lib/relations.ts';
import { collectionRoute, noteRoute, routeKey, tagRoute } from '../../lib/routes.ts';
import { canonicalUrl } from '../../lib/site.ts';
// Loaded as a URL rather than imported, so the stylesheet becomes its own
// content-hashed asset and the `<link>` below can be emitted conditionally.
// Importing it would merge it into the layout's sheet and ship it everywhere,
// which is precisely what owner decision 7 rules out.
import codeStylesheet from '../../styles/code.css?url';
import mathStylesheet from '../../styles/math.css?url';
import diagramStylesheet from '../../styles/diagram.css?url';
import { DIAGRAM_MODE } from '../../lib/diagram-mode.ts';

export function getStaticPaths() {
  return entries.map((entry) => ({ params: { slug: entry.slug }, props: { entry } }));
}

const { entry } = Astro.props;
// The renderer takes this mapping rather than knowing the route shape itself,
// so `/notes/<slug>/` is defined in exactly one place. Returning undefined for
// an unpublished slug leaves that href untouched rather than pointing it at a
// route that does not exist.
//
// `pageTitle` is what lets the anatomy put the title above the article: the
// exporter writes it into the body as a leading `# Title`, and the renderer
// drops that one duplicate rather than the page rendering it twice. A body that
// keeps some *other* `h1` is left alone and fails the "exactly one h1" gate,
// which is the honest outcome — see `RenderOptions.pageTitle`.
const { html, toc, hasCode, hasMath, hasMermaid } = await renderMarkdown(entry.markdown, {
  pageTitle: entry.title,
  routeForSlug: (slug) => (getEntry(slug) ? noteRoute(slug) : undefined),
});

/**
 * `Home / Notes / <collection> / <title>`, from public fields only.
 *
 * `collection` is validated as a flat slug and there is no hierarchy behind it,
 * so the trail is at most four deep. TK-05c owns the collection tree; when it
 * lands, this gains ancestors and nothing else changes. The `/#notes` target is
 * the home page's own listing — requirements section 9.1 defines no `/notes/`
 * index, and `PRIMARY_NAV` already points there.
 *
 * Every segment is a fixed route or an artifact field. Nothing reads a path, so
 * a breadcrumb can never disclose a private folder name.
 */
const collection = entry.collection;
const breadcrumbs: { label: string; href?: string }[] = [
  { label: 'Home', href: '/' },
  { label: 'Notes', href: '/#notes' },
  ...(collection === undefined ? [] : [{ label: collection, href: collectionRoute(collection) }]),
  { label: entry.title },
];

/**
 * The calendar date a reader sees, from an artifact date.
 *
 * The first ten characters, not a parsed and reformatted `Date`. TK-01 has
 * already validated both fields as ISO 8601, so the prefix *is* the calendar
 * date exactly as the exporter wrote it — and taking it verbatim avoids the two
 * ways formatting gets this wrong: a date-only value parsed as UTC midnight and
 * rendered in the build machine's zone shows the previous day west of
 * Greenwich, and a locale format would be a chrome string TK-16 then has to
 * translate. `YYYY-MM-DD` is unambiguous in both of this site's languages.
 *
 * The `<time datetime>` attribute carries the full precise value, so nothing
 * the artifact expressed is lost.
 */
function displayDate(value: string): string {
  return value.slice(0, 10);
}

const canonicalRoute = noteRoute(entry.slug);

/**
 * The three relationship surfaces, resolved once.
 *
 * `outgoing` and `backlinks` are the artifact's authored edges; `related` is
 * derived and says so on the page. All three are computed here rather than in
 * the template so that the markup below reads as the anatomy it is.
 *
 * **A known incompleteness, stated rather than hidden.** The exporter derives
 * `outgoing` from wikilinks only, so the edge set and the body's own links can
 * disagree in both directions: a plain Markdown link in a body renders a live
 * `<a>` with no edge behind it, and — the direction the fixture corpus actually
 * contains, in three entries — an edge exists for a note the body never links
 * in prose. The corpus invariant sees neither: it proves the two edge sets are
 * inverses of *each other*, not that either matches the rendered links. Fixing
 * that is TK-19's exporter contract work, so the heading here says "links to"
 * rather than "every link on this page", and no gate below claims a
 * completeness the data cannot support.
 */
const outgoing = notesForSlugs(entry.outgoing, getEntry);
const backlinks = notesForSlugs(entry.backlinks, getEntry);
const related = relatedNotes(entry, entries);

/**
 * Why the related list is empty, when it is.
 *
 * Two different facts produce the same empty list and a reader deserves to be
 * told which: a note with no tag-sharer anywhere, and a note whose every
 * tag-sharer is already rendered in the two sections above. Saying "nothing
 * shares a tag" in the second case is a claim the artifact contradicts, which
 * is precisely what an honest empty state must not do.
 */
const relatedEmpty = hasTagPeer(entry, entries)
  ? 'Every note sharing a tag with this one is already listed above.'
  : 'No other published note shares a tag with this one.';

/**
 * The pager: its two links and the name it announces, or nothing at all.
 *
 * One value rather than a neighbour pair plus a separate label, so the template
 * has a single condition to branch on. Two conditions is how a pager ends up
 * rendered as an empty `<nav>` for the one shape neither corpus contains — a
 * note alone in its collection. `collectionNeighbours` returns no neighbour for
 * that case and `tests/relations.test.ts` pins it; this keeps the page from
 * being able to disagree.
 *
 * Naming the collection matters because a page carries several `<nav>` elements
 * and a screen reader lists them by name.
 */
const neighbours = collectionNeighbours(entry, entries);
const pager =
  collection !== undefined && (neighbours.previous !== undefined || neighbours.next !== undefined)
    ? { ...neighbours, label: `More in the ${collection} collection` }
    : undefined;
---

<Layout title={`${entry.title} · thoughtscape`} description={entry.excerpt} lang={entry.language}>
  {/*
    Owner decision 7, the live case. Each flag is true only when the body
    contains the construct, so each sheet reaches only the pages that render
    one. Three conditional `<link>` elements rather than one merged sheet:
    merging Mermaid's per-diagram-type stylesheets was measured at 6,354 B gzip
    against a 972 B median for a single type, and the build-time renderer
    removes the need for either — `diagram.css` is 14 rules because the theming
    is flattened onto the SVG itself.

    `hasMath` also gates the ~9 KB Temml stylesheet and, through its
    `unicode-range`, the 9.4 KB `Temml.woff2` — which a browser fetches only for
    an expression that actually uses `\mathscr`.
  */}
  {hasCode && <link slot="head" rel="stylesheet" href={codeStylesheet} />}
  {hasMath && <link slot="head" rel="stylesheet" href={mathStylesheet} />}
  {hasMermaid && <link slot="head" rel="stylesheet" href={diagramStylesheet} />}
  {/*
    Client mode only, and only on a page that has a diagram.

    Astro bundles a script tag **eagerly**: the `hasMermaid` condition decides
    whether the tag is rendered, not whether the module is built. Keeping
    Mermaid out of `dist/` in build-time mode is therefore done in
    `astro.config.mjs`, which resolves `src/scripts/diagram.ts` to an empty stub
    unless client mode is selected. Both halves are needed — this one so a
    diagram-free page requests nothing, that one so a diagram-free *build*
    contains nothing. `tests/math-and-diagrams.test.ts` asserts both over
    `dist/`.

    `DIAGRAM_MODE` is checked here as well, so build-time mode emits no tag at
    all rather than one pointing at a 20-byte empty chunk. It is not what keeps
    Mermaid out — the resolver is — but a request for nothing is still a
    request.
  */}
  {hasMermaid && DIAGRAM_MODE === 'client' && (
    <script>
      import '../../scripts/diagram.ts';
    </script>
  )}

  <header class="note-header">
    {/* § 9.2.3 — the trail. Public fields only; never a private folder name. */}
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <ol>
        {breadcrumbs.map((crumb) => (
          <li>
            {crumb.href === undefined ? (
              <span aria-current="page">{crumb.label}</span>
            ) : (
              <a href={crumb.href}>{crumb.label}</a>
            )}
          </li>
        ))}
      </ol>
    </nav>

    {/* § 9.2.4 — the title, and the public metadata the artifact actually
        carries. Every row below is optional in the contract, so each is
        conditional: a note with none of them renders a title and nothing else,
        which is the published corpus today. */}
    <h1 class="note-title">{entry.title}</h1>

    {(entry.created !== undefined ||
      entry.updated !== undefined ||
      collection !== undefined ||
      (entry.tags?.length ?? 0) > 0) && (
      <dl class="note-meta">
        {entry.created !== undefined && (
          <div>
            <dt>Published</dt>
            <dd><time datetime={entry.created}>{displayDate(entry.created)}</time></dd>
          </div>
        )}
        {entry.updated !== undefined && (
          <div>
            <dt>Updated</dt>
            <dd><time datetime={entry.updated}>{displayDate(entry.updated)}</time></dd>
          </div>
        )}
        {collection !== undefined && (
          <div>
            <dt>Collection</dt>
            <dd><a href={collectionRoute(collection)}>{collection}</a></dd>
          </div>
        )}
        {entry.tags !== undefined && entry.tags.length > 0 && (
          <div>
            <dt>Tags</dt>
            <dd>
              <ul class="note-tags">
                {entry.tags.map((tag) => (
                  <li><a href={tagRoute(routeKey(tag))}>{tag}</a></li>
                ))}
              </ul>
            </dd>
          </div>
        )}
      </dl>
    )}

    {/* § 9.2.5 — the optional summary.
        `description` verbatim, with no comparison against `excerpt`: the two
        are separate artifact fields, the excerpt is never rendered on this page
        (it is the `<meta name="description">` and the card body elsewhere), and
        a note whose author wrote the same sentence into both still asked for a
        summary. Suppressing on equality was tried and was a product decision
        this ticket has no reason to make. */}
    {entry.description !== undefined && <p class="note-summary">{entry.description}</p>}
  </header>

  {/* § 9.2.6 — the table of contents, on pages above `TOC_MIN_HEADINGS`. The
      renderer returns an empty `toc` below the threshold, so the threshold
      lives in one place and this is only the rendering decision. */}
  {toc.length > 0 && <TableOfContents entries={toc} isRoot />}

  {/* § 9.2.7 — the sanitized article body. */}
  <article class="prose" data-pagefind-body>
    <div set:html={html} />
  </article>

  {/* § 9.2.8 — outgoing public links: the notes this one links to, by title.
      Every target is a published entry — `checkCorpus` proves it — so this can
      never be a dead link or a private title. */}
  <LinkedNotes
    region="outgoing"
    heading="Links to"
    entries={outgoing}
    empty="This note links to no other published note."
  />

  {/* § 9.2.9 — static backlinks. Requirements section 13.1 asks for five
      things: source title, source route, an optional source heading, a bounded
      sanitized context excerpt, and a stable sort order. Three are rendered.
      The heading and the context excerpt are not, because the artifact carries
      one slug per edge and nothing about *where* in the source that edge is —
      no heading, no offset, no surrounding text.

      `ContentEntry.excerpt` is deliberately not substituted for the missing
      one. It is the source note's own summary — the same string the card, the
      `<meta name="description">`, and the hover preview all use — and it is
      derived from the note's opening, not from the passage that links here.
      Printed under a backlink it would read as the context of the link while
      being unrelated to it, which is the fabrication the empty states exist to
      avoid: a wrong answer presented in the shape of a right one is worse than
      no answer. A real context excerpt needs a per-edge field; that is TK-19's
      exporter contract work. */}
  <LinkedNotes
    region="backlinks"
    heading="Linked from"
    entries={backlinks}
    empty="No published note links here yet."
  />

  {/* § 9.2.10 — the related-note fallback. Derived, not authored, and the
      markup says so: the rule is stated below the heading so a reader is never
      left to guess whether the owner put these here. `relations.ts` documents
      the rule and the alternatives it was chosen over. */}
  <LinkedNotes
    region="related"
    heading="Related notes"
    entries={related}
    empty={relatedEmpty}
    derivation={RELATED_DERIVATION}
  />

  {/* § 9.2.11 — the local-graph neighborhood. TK-17 owns it, as build-time
      inline SVG with real `<a>` elements plus the equivalent list section 17
      requires. TK-21's interactive layer must not be stubbed in here. */}

  {/* § 9.2.12 — collection navigation, "where meaningful": only inside a
      collection that has another note, and in the same order
      `/collections/<key>/` lists them. A note with no collection, or the only
      note in one, renders nothing rather than a pager with two dead ends. */}
  {pager !== undefined && (
    <nav class="collection-pager" aria-label={pager.label}>
      {/* The link carries the destination's own title, so it is a meaningful
          link out of context — "Previous" alone would be four identical link
          names on a screen reader's link list. The direction word is a
          separate element rather than part of the link text for the same
          reason. */}
      {pager.previous !== undefined && (
        <a href={noteRoute(pager.previous.slug)} rel="prev">
          <span class="pager-direction">Previous</span>
          <span class="pager-title">{pager.previous.title}</span>
        </a>
      )}
      {pager.next !== undefined && (
        <a class="pager-next" href={noteRoute(pager.next.slug)} rel="next">
          <span class="pager-direction">Next</span>
          <span class="pager-title">{pager.next.title}</span>
        </a>
      )}
    </nav>
  )}

  {/* § 9.2.13 — the footer: public provenance and the canonical route. */}
  <footer class="note-footer">
    <p>
      A reviewed public projection. This page was published because it was named on an
      explicit approval list, and it carries only what that projection includes.
    </p>
    {/* TK-08 configured `site:`, so this is the full canonical URL rather than
        the route TK-05a could honestly emit. A reader who copies it from a
        printed or quoted page gets an address that resolves. */}
    <p class="note-canonical">Canonical URL: {canonicalUrl(Astro.site, canonicalRoute)}</p>
  </footer>
</Layout>
