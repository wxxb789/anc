---
/**
 * Static 404.
 *
 * Astro emits `src/pages/404.astro` as `dist/404.html`, which Cloudflare Pages
 * serves for any unmatched request. It is a real page in the layout shell, not
 * a bare message: a reader who lands here still has the full site navigation.
 *
 * The routes offered are the site's own fixed routes. Nothing here reports what
 * was requested — echoing the URL back into the page is how a 404 becomes a
 * reflected-content sink, and it would tell a visitor nothing they did not type.
 */
import Layout from '../layouts/Layout.astro';
import { SITE_MAP } from '../lib/routes.ts';
import { TITLE_SUFFIX } from '../lib/site.ts';
import { NAV_LANGUAGE, translate } from '../lib/translations.ts';

// The one route with no document behind it at all: the host serves this body
// for any unmatched address, so there is nothing whose language could be read.
const t = translate(NAV_LANGUAGE);
---

<Layout title={`${t.notFoundTitle}${TITLE_SUFFIX}`} description={t.notFoundDescription}>
  <article class="prose">
    <h1>{t.notFoundTitle}</h1>

    <p>{t.notFoundBody}</p>

    <h2>{t.notFoundWhereTo}</h2>

    <ul>
      {SITE_MAP.map((item) => <li><a href={item.href}>{t[item.label]}</a></li>)}
    </ul>
  </article>
</Layout>
