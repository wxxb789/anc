# build output
dist/
# packaged CLI staging (bin/thoughtscape-publish.mjs; one per run, removed after)
.thoughtscape-build-*/
# compiled package staging (scripts/compile-package.ts; rebuilt by `pnpm run pack`)
.package/
# `npm pack` output, written to the repository root unless --pack-destination
*.tgz
# generated types
.astro/
# per-build private metadata consumed before dist is published
*.publish-state/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# agent scratch space (never committed)
.tmp/

# agent worktrees (harness scratch, never committed)
.claude/
