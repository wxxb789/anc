{
  "name": "thoughtscape-publish",
  "type": "module",
  "version": "0.0.1",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sync:content": "python ../thoughtscape/ob-flow/.harness/publish/export.py --target .",
    "validate:content": "node scripts/validate-content.ts",
    "emit:redirects": "node scripts/emit-redirects.ts",
    "check": "astro check",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm run validate:content && astro build && pnpm run emit:redirects && pagefind --site dist --exclude-selectors \".heading-anchor\" && pnpm run scan:residue",
    "build:fixture": "node scripts/build-fixture.ts",
    "scan:residue": "node scripts/scan-residue.ts",
    "verify": "pnpm run lint && pnpm run check && pnpm run build && pnpm run test",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/prism": "^4.0.2",
    "astro": "^7.1.6",
    "github-slugger": "^2.0.0",
    "prismjs": "^1.30.0",
    "sanitize-html": "^2.17.0",
    "satteri": "^0.9.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "happy-dom": "20.11.2",
    "mermaid": "11.16.1",
    "oxlint": "^1.77.0",
    "pagefind": "^1.4.0",
    "playwright": "^1.62.1",
    "temml": "0.13.4",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
