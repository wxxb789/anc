{
  "name": "thoughtscape-publish",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "sync:content": "python ../thoughtscape/ob-flow/.harness/publish/export.py --target .",
    "validate:content": "node scripts/validate-content.ts",
    "check": "astro check",
    "test": "node --test",
    "build": "npm run validate:content && astro build && pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.1.6",
    "marked": "^16.3.0",
    "sanitize-html": "^2.17.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "pagefind": "^1.4.0",
    "typescript": "^5.9.3"
  }
}
