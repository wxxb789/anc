{
  "name": "@wxxb789/anc",
  "type": "module",
  "version": "0.0.1",
  "description": "Build a static, privacy-preserving site from a directory of Markdown",
  "keywords": [
    "static-site-generator",
    "static-site",
    "markdown",
    "obsidian",
    "digital-garden",
    "knowledge-base",
    "backlinks",
    "full-text-search",
    "pagefind",
    "privacy",
    "self-hosted",
    "astro",
    "sqlite",
    "wasm"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wxxb789/anc.git"
  },
  "bugs": {
    "url": "https://github.com/wxxb789/anc/issues"
  },
  "homepage": "https://github.com/wxxb789/anc#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "bin": {
    "anc": "bin/anc.mjs"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "astro.config.mjs",
    "bin",
    "public",
    "scripts",
    "src",
    "tsconfig.json",
    "!src/data/content.json",
    "!scripts/build-fixture.ts",
    "!scripts/compile-package.ts",
    "!scripts/build-site.ts",
    "!scripts/dist-lock.ts",
    "!scripts/npm-command.ts",
    "!scripts/benchmark-browser.ts",
    "!scripts/benchmark-candidate.ts",
    "!scripts/benchmark-corpus.ts",
    "!scripts/benchmark-driver.ts",
    "!scripts/benchmark-files.ts",
    "!scripts/benchmark-host.ts",
    "!scripts/benchmark-identity.ts",
    "!scripts/benchmark-limits.ts",
    "!scripts/benchmark-oracle.ts",
    "!scripts/benchmark-package.ts",
    "!scripts/benchmark-page.ts",
    "!scripts/benchmark-server.ts",
    "!scripts/benchmark-snapshot.ts",
    "!scripts/benchmark-stats.ts",
    "!scripts/benchmark-transfer.ts",
    "!scripts/benchmark-workload-driver.ts",
    "!scripts/benchmark-workload-report.ts",
    "!scripts/benchmark-workload-ui.ts",
    "!scripts/benchmark-workload.ts",
    "!scripts/smoke-tarball.ts"
  ],
  "scripts": {
    "dev": "astro dev",
    "validate:content": "node scripts/validate-content.ts",
    "emit:redirects": "node scripts/emit-redirects.ts",
    "check": "astro check",
    "lint": "oxlint",
    "test": "vitest run --maxWorkers=4",
    "test:watch": "vitest",
    "index:search": "node scripts/run-pagefind.ts",
    "build": "node scripts/build-site.ts",
    "build:fixture": "node scripts/build-fixture.ts",
    "build:example": "node bin/anc.mjs build --content example --out .tmp/example-dist",
    "pack:tarball": "node scripts/compile-package.ts",
    "smoke:tarball": "node scripts/smoke-tarball.ts",
    "benchmark:snapshot": "node scripts/benchmark-snapshot.ts",
    "prepack": "node -e \"throw new Error('run pnpm run pack:tarball -- a bare pack ships the .ts sources Node cannot strip under node_modules')\"",
    "scan:residue": "node scripts/scan-residue.ts",
    "verify": "pnpm run lint && pnpm run check && node scripts/build-site.ts --scan-secrets && pnpm run test",
    "preview": "astro preview",
    "preview:example": "node bin/anc.mjs preview --dist .tmp/example-dist",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/prism": "^4.0.2",
    "@sqlite.org/sqlite-wasm": "3.53.4-build1",
    "astro": "^7.3.2",
    "github-slugger": "^2.0.0",
    "happy-dom": "20.11.2",
    "mermaid": "11.16.1",
    "pagefind": "^1.4.0",
    "prismjs": "^1.30.0",
    "sanitize-html": "^2.17.7",
    "satteri": "^0.9.5",
    "temml": "0.13.4",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "oxlint": "^1.77.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
